##############################################################################
# Удалённое состояние в S3-совместимом хранилище.
#
# Здесь намеренно ЧАСТИЧНАЯ конфигурация (partial backend configuration):
#   * неконфиденциальные параметры (бакет, ключ, endpoint) — в backend-stage.hcl;
#   * ключи доступа — только в переменных окружения AWS_ACCESS_KEY_ID /
#     AWS_SECRET_ACCESS_KEY, которые CI/CD подставляет из защищённых переменных.
#
# Инициализация:
#   terraform init -backend-config=backend-stage.hcl
##############################################################################

terraform {
  backend "s3" {}
}
